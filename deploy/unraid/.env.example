# Existing user-defined Docker network that Paperless-ngx can reach.
PAPERLESS_NETWORK=paperless-ai-internal

# Persistent token location on the Unraid array/cache.
APPDATA_PATH=/mnt/user/appdata/paperless-chatgpt-proxy

# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
PROXY_API_KEY=replace-with-a-random-value

CHATGPT_MODEL=gpt-5.6-luna
CHATGPT_REASONING_EFFORT=low
CHATGPT_REQUEST_TIMEOUT=300

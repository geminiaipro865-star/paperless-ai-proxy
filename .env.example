# Shared secret between paperless-ngx and the proxy. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PROXY_API_KEY=change-me

# Model slug requested from the ChatGPT backend. `chatgpt-proxy` exposes the
# list your plan can actually reach at GET /v1/models.
CHATGPT_MODEL=gpt-5.1-codex-mini

# none | low | medium | high -- higher burns more of your plan's quota.
CHATGPT_REASONING_EFFORT=low

# Seconds. Classification of a long document with RAG context can be slow.
CHATGPT_REQUEST_TIMEOUT=300
